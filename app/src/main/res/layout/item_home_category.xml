<?xml version="1.0" encoding="utf-8"?>
<!--
  كرت قسم في الهوم — نفس الـ layout يُستخدم للأقسام الثلاثة عبر <include>،
  والأيقونة واللون والنصوص تُعبأ من HomeActivity.bindCategory().
  العرض يجي من layout_weight في activity_home (ثلاثة كروت متساوية)، مو من هنا.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivCategoryIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_book_open" />

        <TextView
            android:id="@+id/tvCategoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeMinTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="@string/books" />

        <!-- الوزن يدفع السهم لأسفل الكرت، فتتساوى أماكن الأسهم حتى لو اختلف طول الوصف -->
        <TextView
            android:id="@+id/tvCategoryDesc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            tools:text="@string/books_desc" />

        <ImageView
            android:id="@+id/ivCategoryArrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_forward" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
